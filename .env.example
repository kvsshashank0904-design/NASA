# MARS-X environment variables. Copy to .env and edit.
#
# docker compose reads this file (./.env) for variable substitution in docker-compose.yml.
# For local development without Docker, the backend reads MARSX_* variables from the process
# environment, or from a .env file in the directory uvicorn is started from (usually backend/).

# --- AI assistant (optional) ---------------------------------------------------------------
# Without a key, MARS AI runs its deterministic tool planner over the same backend tools.
ANTHROPIC_API_KEY=
# Alternative name read by app.config (takes precedence for the API client when set).
# Use this name in a backend/.env file: pydantic-settings only reads MARSX_* keys from .env,
# while ANTHROPIC_API_KEY is only seen when it is a real process environment variable.
# (ANTHROPIC_AUTH_TOKEN in the environment is also accepted.)
# MARSX_ANTHROPIC_API_KEY=
# Model id used in LLM mode (default claude-opus-5-5).
# MARSX_AI_MODEL=claude-opus-5-5
# Maximum tool-calling rounds per chat request (default 8).
# MARSX_AI_MAX_TOOL_ROUNDS=8

# --- Database --------------------------------------------------------------------------------
# Local default: sqlite:///<backend>/marsx.db (tables created automatically).
# PostgreSQL/PostGIS: run `python -m alembic upgrade head` before starting the app.
# docker-compose.yml builds this URL itself from the POSTGRES_* values below.
# MARSX_DATABASE_URL=postgresql+psycopg://marsx:marsx@localhost:5432/marsx
POSTGRES_USER=marsx
POSTGRES_PASSWORD=marsx
POSTGRES_DB=marsx

# --- Data cache and network ----------------------------------------------------------------
# Where MOLA bands (.npy), the Jezero CTX DTM and weather feed copies are cached.
# Local default: backend/data_cache. Docker: /data/cache (named volume).
# MARSX_CACHE_DIR=
# true = never touch the network; serve only cached data and bundled snapshots.
MARSX_OFFLINE=false
# Timeout for DEM downloads, seconds (default 60).
# MARSX_HTTP_TIMEOUT_S=60
# How long a fetched weather feed is reused, seconds (default 21600 = 6 h).
# MARSX_WEATHER_TTL_S=21600

# --- HTTP ------------------------------------------------------------------------------------
# Comma-separated origins allowed by CORS.
MARSX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend --------------------------------------------------------------------------------
# Backend URL as seen from the user's browser. Inlined into the Next.js bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
